# ==============================================================================
# SIH26153 Environment Configuration Template
# Copy to .env and configure local variables
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS
# ==============================================================================

# Application Environment
ENV=development
DEBUG=true
APP_NAME="SIH26153 Network Attack Forecaster"
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=sih26153_forecasting

# Database Connection URLs
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/sih26153_forecasting
SYNC_DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/sih26153_forecasting

# Directory Paths
DATA_DIR=./data
CONFIG_PATH=./configs/config.yaml

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
